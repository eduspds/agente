# ─── Desenvolvimento (recomendado) ────────────────────────────────────────────
# Não defina VITE_API_URL / VITE_WS_URL para usar o proxy do Vite (porta 5173)
# e encaminhar /api e /socket.io para o backend em http://localhost:3000.
#
# Se definir URL absoluta para :3000, o browser fala direto com o Nest — o backend
# tem de estar a correr, senão verá "Não foi possível contactar o servidor".

# VITE_API_URL=/api/v1
# VITE_WS_URL=

# ─── Chamada direta ao backend (sem proxy) ───────────────────────────────────
# VITE_API_URL=http://localhost:3000/api/v1
# VITE_WS_URL=http://localhost:3000

# ─── Produção (ajuste ao seu domínio / API) ───────────────────────────────────
# VITE_API_URL=https://api.seudominio.com/api/v1
# VITE_WS_URL=https://api.seudominio.com
