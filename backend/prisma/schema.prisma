generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
}

enum LeadStatus {
  NOVO
  EM_QUALIFICACAO
  QUALIFICADO
  DESQUALIFICADO
  ESPECIALISTA
}

enum Source {
  AI
  HUMAN
  SYSTEM
}

enum WhatsappStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

// ─── Modelos ──────────────────────────────────────────────────────────────────

model Tenant {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  active            Boolean  @default(true)

  // IA
  aiProvider        String   @default("openai")
  aiModel           String   @default("gpt-4o-mini")
  aiApiKey          String   @default("")
  aiBaseUrl         String   @default("https://api.openai.com/v1")
  aiTimeoutMs       Int      @default(30000)
  aiConfidThreshold Float    @default(0.6)
  aiPrompt          String   @default("")
  promptVersion     Int      @default(1)

  // Funil
  requiredFields    String[] @default(["name", "plate", "email"])
  specialistName    String?
  specialistContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  leads             Lead[]
  messages          Message[]
  aiAnalyses        AiAnalysis[]
  auditLogs         AuditLog[]
  funnelEvents      FunnelEvent[]
  whatsappInstance  WhatsappInstance?
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  password  String
  role      Role     @default(AGENT)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, active])
}

model Lead {
  id              String     @id @default(uuid())
  tenantId        String
  chatId          String
  phone           String
  name            String?
  plate           String?
  email           String?
  status          LeadStatus @default(NOVO)
  intent          String?
  sentiment       String?
  confidenceScore Float?
  priorityScore   Float?
  needsHumanReview Boolean   @default(false)
  lastMessageAt   DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages     Message[]
  aiAnalyses   AiAnalysis[]
  auditLogs    AuditLog[]
  funnelEvents FunnelEvent[]

  @@unique([tenantId, chatId])
  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
}

model Message {
  id         String   @id @default(uuid())
  tenantId   String
  leadId     String
  messageId  String   @unique
  chatId     String
  fromMe     Boolean
  body       String
  timestamp  DateTime
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, chatId, timestamp])
  @@index([leadId, processed])
}

model AiAnalysis {
  id              String   @id @default(uuid())
  tenantId        String
  leadId          String
  messageIds      String[]
  promptSent      String
  rawResponse     String
  parsedResult    Json
  intent          String
  sentiment       String
  confidenceScore Float
  extractedFields Json
  mentionedCompany  Boolean @default(false)
  mentionedLicense  Boolean @default(false)
  promptVersion   Int
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
}

model AuditLog {
  id       String  @id @default(uuid())
  tenantId String
  leadId   String
  userId   String
  field    String
  oldValue String?
  newValue String?
  source   Source
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, leadId])
}

model FunnelEvent {
  id          String     @id @default(uuid())
  tenantId    String
  leadId      String
  fromStatus  LeadStatus
  toStatus    LeadStatus
  reason      String?
  triggeredBy String
  createdAt   DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId])
}

model WhatsappInstance {
  id           String         @id @default(uuid())
  tenantId     String         @unique
  instanceName String         @unique
  phone        String?
  status       WhatsappStatus @default(DISCONNECTED)
  webhookUrl   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
