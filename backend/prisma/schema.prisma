// LeadWatch — Prisma Schema (instância única / single-tenant)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
  VIEWER
}

enum LeadStatus {
  NOVO
  EM_QUALIFICACAO
  QUALIFICADO
  DESQUALIFICADO
  ESPECIALISTA
  PENDENTE_IDENTIFICACAO
}

enum Source {
  AI
  HUMAN
  SYSTEM
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  CONNECTING
  QR_PENDING
}

// ─── Configuração global da instância (uma única linha, id = "default") ─────

model AppSettings {
  id             String   @id @default("default")
  name           String
  slug           String   @unique
  aiPrompt       String   @db.Text
  promptVersion  Int      @default(1)
  requiredFields String[]
  aiSettings     Json     @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Conexões WhatsApp ─────────────────────────────────────────────────────────

model WhatsappConnection {
  id           String           @id @default("default")
  name         String
  instanceName String           @unique
  status       ConnectionStatus @default(DISCONNECTED)
  phone        String?
  qrCode       String?          @db.Text
  lastSeenAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]
}

// ─── Lead ─────────────────────────────────────────────────────────────────────

model Lead {
  id                String     @id @default(uuid())
  chatId            String     @unique
  phone             String?
  name              String?
  plate             String?
  email             String?
  status            LeadStatus @default(NOVO)
  intent            String?
  sentiment         String?
  confidenceScore   Float?
  priorityScore     Float?
  needsHumanReview  Boolean    @default(false)
  humanOverrideFields String[] @default([])
  summary           String?    @db.Text
  missingFields     String[]   @default([])
  disqualifyReason  String?
  lastMessageAt     DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  messages     Message[]
  aiAnalyses   AiAnalysis[]
  auditLogs    AuditLog[]
  funnelEvents FunnelEvent[]

  @@index([status])
  @@index([lastMessageAt])
  @@index([priorityScore])
}

// ─── Message ──────────────────────────────────────────────────────────────────

model Message {
  id        String   @id @default(uuid())
  leadId    String
  messageId String   @unique
  chatId    String
  fromMe    Boolean
  body      String   @db.Text
  timestamp DateTime
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([chatId, timestamp])
  @@index([leadId, processed])
}

// ─── AiAnalysis ───────────────────────────────────────────────────────────────

model AiAnalysis {
  id              String   @id @default(uuid())
  leadId          String
  messageIds      String[]
  promptSent      String   @db.Text
  rawResponse     String   @db.Text
  parsedResult    Json
  intent          String
  sentiment       String
  confidenceScore Float
  extractedFields Json
  promptVersion   Int
  cacheHit        Boolean  @default(false)
  tokensUsed      Int?
  latencyMs       Int?
  createdAt       DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────

model AuditLog {
  id       String   @id @default(uuid())
  leadId   String
  userId   String?
  field    String
  oldValue String?
  newValue String?
  source   Source
  metadata Json?
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([createdAt])
}

// ─── FunnelEvent ──────────────────────────────────────────────────────────────

model FunnelEvent {
  id          String     @id @default(uuid())
  leadId      String
  fromStatus  LeadStatus
  toStatus    LeadStatus
  reason      String?
  triggeredBy String
  metadata    Json?
  createdAt   DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([createdAt])
}
