# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://leadwatch:leadwatch@localhost:5432/leadwatch

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=change_me_in_production_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── AI (OpenAI-compatible) ───────────────────────────────────────────────────
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1000
AI_CONFIDENCE_THRESHOLD=0.6

# ─── Queue (BullMQ) ───────────────────────────────────────────────────────────
QUEUE_DEBOUNCE_MS=180000
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_MS=5000

# ─── Baileys API ──────────────────────────────────────────────────────────────
# Segredo HMAC para validar assinatura do webhook
BAILEYS_WEBHOOK_SECRET=change_me_in_production_webhook_secret
# Instância padrão ao criar a sessão única (id=default) no banco
BAILEYS_DEFAULT_INSTANCE=leadwatch
# Opcional: URL POST do sidecar para envio de mensagens (corpo JSON: { instance, to, text })
# BAILEYS_MESSAGE_URL=http://localhost:8080/send
# BAILEYS_MESSAGE_SECRET=

# ─── Frontend ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
